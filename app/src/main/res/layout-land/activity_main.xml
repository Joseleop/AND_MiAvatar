<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bgimg"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/text_titulo_ficha"
        android:textSize="@dimen/texto_titulo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Fila de botones: cadena horizontal repartida -->
    <Button
        android:id="@+id/btnNombre"
        style="@style/Boton_de_datos"
        android:layout_marginTop="8dp"
        android:text="@string/texto_boton_nombre"
        app:layout_constraintEnd_toStartOf="@id/btnSexo"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo" />

    <Button
        android:id="@+id/btnSexo"
        style="@style/Boton_de_datos"
        android:text="@string/texto_boton_sexo"
        app:layout_constraintEnd_toStartOf="@id/btnRaza"
        app:layout_constraintStart_toEndOf="@id/btnNombre"
        app:layout_constraintTop_toTopOf="@id/btnNombre" />

    <Button
        android:id="@+id/btnRaza"
        style="@style/Boton_de_datos"
        android:text="@string/texto_boton_raza"
        app:layout_constraintEnd_toStartOf="@id/btnProfesion"
        app:layout_constraintStart_toEndOf="@id/btnSexo"
        app:layout_constraintTop_toTopOf="@id/btnNombre" />

    <Button
        android:id="@+id/btnProfesion"
        style="@style/Boton_de_datos"
        android:text="@string/texto_boton_profesion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnRaza"
        app:layout_constraintTop_toTopOf="@id/btnNombre" />

    <!-- Ficha: ancho completo, ocupa el alto restante -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_second"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:background="@drawable/fondo_pergamino"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnNombre">

        <!-- Bloque izquierdo: hasta el 32 % -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guiaTextos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.32" />

        <!-- Bloque central (avatar): del 32 % al 57 % -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guiaColumnas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.55" />

        <TextView
            android:id="@+id/tvNombreFicha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/marron_oscuro"
            android:textSize="@dimen/texto_ficha_nombre"
            app:layout_constraintBottom_toTopOf="@id/tvRazaProfesion"
            app:layout_constraintEnd_toStartOf="@id/guiaTextos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvRazaProfesion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/dorado"
            android:textSize="@dimen/texto_ficha_subtitulo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guiaTextos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNombreFicha" />

        <!-- Avatar: el ancho sale del alto (proporción 25:36) -->
        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="W,25:36"
            app:layout_constraintEnd_toStartOf="@id/guiaColumnas"
            app:layout_constraintStart_toStartOf="@id/guiaTextos"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Línea divisoria decorativa -->
        <View
            android:id="@+id/divisorFicha"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/marron_medio"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/guiaTextos"
            app:layout_constraintStart_toStartOf="@id/guiaTextos"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Bloque derecho: stats y Reiniciar -->
        <LinearLayout
            android:id="@+id/columnaStats"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="100dp"
            app:layout_constraintBottom_toTopOf="@id/btnReset"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guiaColumnas"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvVida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:drawableStart="@drawable/ic_vida"
                android:drawablePadding="10dp"
                android:text="@string/texto_stats_vida"
                android:textSize="@dimen/texto_stat" />

            <TextView
                android:id="@+id/tvMagia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:drawableStart="@drawable/ic_magia"
                android:drawablePadding="10dp"
                android:text="@string/texto_stats_magia"
                android:textSize="@dimen/texto_stat" />

            <TextView
                android:id="@+id/tvFuerza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:drawableStart="@drawable/ic_fuerza"
                android:drawablePadding="10dp"
                android:text="@string/texto_stats_fuerza"
                android:textSize="@dimen/texto_stat" />

            <TextView
                android:id="@+id/tvVelocidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_velocidad"
                android:drawablePadding="10dp"
                android:text="@string/texto_stats_velocidad"
                android:textSize="@dimen/texto_stat" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGenerar"
            style="@style/Boton_de_datos"
            android:layout_width="wrap_content"
            android:layout_marginBottom="4dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/texto_boton_generar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnReset"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@id/guiaColumnas"
            app:layout_constraintTop_toBottomOf="@id/columnaStats" />

        <Button
            android:id="@+id/btnReset"
            style="@style/Boton_reiniciar"
            android:layout_width="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/texto_boton_reiniciar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnGenerar"
            app:layout_constraintTop_toBottomOf="@id/columnaStats" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>