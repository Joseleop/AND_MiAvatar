<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Boton_de_datos" parent="Widget.Material3.Button">
        <item name="android:layout_width">@dimen/boton_datos_ancho</item>
        <item name="android:layout_height">@dimen/boton_datos_alto</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/marron_oscuro</item>
        <item name="backgroundTint">@color/pergamino_oscuro</item>
        <item name="strokeColor">@color/marron_medio</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- Estilo del diálogo -->
    <style name="DialogoPergamino" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/fondo_pergamino</item>
        <item name="android:textColorPrimary">@color/marron_oscuro</item>
        <item name="android:textColorSecondary">@color/marron_oscuro</item>
        <item name="android:colorAccent">@color/rojo_sello</item>
        <item name="android:fontFamily">@font/uncial_antiqua</item>
        <item name="android:buttonBarButtonStyle">@style/BotonDialogo</item>
    </style>

    <style name="BotonDialogo" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">@color/marron_oscuro</item>
    </style>
</resources>